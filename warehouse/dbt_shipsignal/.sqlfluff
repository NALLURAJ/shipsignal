[sqlfluff]
templater = dbt
dialect = postgres
max_line_length = 120
# aliasing, keyword capitalisation and layout rules fight with the style used here
exclude_rules = AL01, AL03, AL07, AM04, CP01, CP02, CP03, LT01, LT02, LT05, LT09, RF04, ST06, ST09, ST05, ST07, AM05

[sqlfluff:templater:dbt]
project_dir = .
profiles_dir = .
